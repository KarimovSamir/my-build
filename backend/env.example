# ─────────────────────────────────────────────────────────────
# Шаблон переменных окружения для backend.
#
# Скопируй этот файл в backend/.env и заполни значения.
# backend/.env в git не попадает (см. .gitignore в корне).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Откуда разрешены запросы. Локально — адрес Next.js.
# Несколько адресов — через запятую, без пробелов.
CORS_ORIGINS=http://localhost:3000


# ─── Supabase: подключение к Postgres ───────────────────────
# Панель Supabase → кнопка Connect сверху → вкладка ORMs → Prisma.
# Там сразу показаны обе строки в готовом виде.
#
# DATABASE_URL — пул соединений (Transaction pooler, порт 6543).
#   Через него работает приложение. Обязателен параметр ?pgbouncer=true
# DIRECT_URL — прямое подключение (порт 5432).
#   Нужен только Prisma для миграций, приложение его не использует.
#
# Пароль базы задаётся при создании проекта. Забыл — Settings →
# Database → Reset database password.

DATABASE_URL=
DIRECT_URL=


# ─── Supabase: проект и секретный ключ ──────────────────────
# Панель Supabase → Settings → API

# Адрес проекта, вида https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Settings → API Keys → секретный ключ (secret / service_role).
# Даёт полный доступ к базе в обход RLS.
# НИКОГДА не переносить во frontend и не давать префикс NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=


# ─── Supabase Auth: проверка подписи JWT ────────────────────
# Backend проверяет токен локально по этим данным и в Supabase
# на каждый запрос не ходит. Без них приложение не стартует.

# Обычно: <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Обычно: <SUPABASE_URL>/auth/v1
SUPABASE_JWT_ISSUER=

# Для обычных пользователей всегда authenticated
SUPABASE_JWT_AUDIENCE=authenticated


# ─── Supabase Storage ───────────────────────────────────────
# Имя приватного бакета для файлов заказов.
# Сам бакет заводится командой `npm run storage:setup -w backend`
# (идемпотентна: если бакет есть, просто приводит настройки к нужным).
SUPABASE_STORAGE_BUCKET=order-files
