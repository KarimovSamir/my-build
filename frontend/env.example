# ─────────────────────────────────────────────────────────────
# Шаблон переменных окружения для frontend.
#
# Скопируй этот файл в frontend/.env и заполни значения.
# frontend/.env в git не попадает (см. .gitignore в корне).
# Личные переопределения кладите в frontend/.env.local — Next.js читает
# его последним, и он тоже не попадает в git.
#
# ВАЖНО: всё с префиксом NEXT_PUBLIC_ попадает в браузер и видно
# любому пользователю. Секретных ключей здесь быть не должно.
# ─────────────────────────────────────────────────────────────

# ─── Supabase Auth ──────────────────────────────────────────
# Панель Supabase → Settings → API

# Адрес проекта, вида https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Settings → API Keys → публикуемый ключ (publishable / anon).
# Он и задуман открытым: по нему нельзя прочитать ни одной
# таблицы, потому что на всех включён RLS без политик.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ─── Адрес нашего API ───────────────────────────────────────
# Локально — NestJS на своём порту.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Адрес WebSocket-шлюза (namespace /ws задаётся в коде клиента).
NEXT_PUBLIC_WS_URL=http://localhost:4000
